{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2025",
    "moduleResolution": "NodeNext",
    "noImplicitAny": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "build",
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ES2025", "ESNext.Collection", "ESNext.Disposable", "ESNext.Temporal"],
    "strictNullChecks": true,
    "allowJs": true
  },
  "include": ["src/**/*"],
  "exclude": ["build", "node_modules"]
}
