{
  "name": "freemap-v3-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreemapSlovakia/freemap-v3-nodejs-backend.git"
  },
  "author": {
    "name": "Freemap Slovakia",
    "email": "freemap@freemap.sk"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/FreemapSlovakia/freemap-v3-nodejs-backend/issues"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "biome check --error-on-warnings",
      "git add"
    ]
  },
  "scripts": {
    "start": "node --enable-source-maps --import ./build/instrument.js build/index.js",
    "copy:assets": "cp src/routers/gallery/pictures.proto build/routers/gallery/pictures.proto && cp src/routers/mapApps/Freemap.png build/routers/mapApps/Freemap.png && rm -rf build/mapCatalog && mkdir -p build/mapCatalog/eli build/mapCatalog/curated && cp mapCatalog/eli/eliCatalog.json build/mapCatalog/eli/ && cp mapCatalog/curated/curatedCatalog.json build/mapCatalog/curated/",
    "build": "tsc && pnpm run copy:assets",
    "test": "tsc && pnpm run copy:assets && node --test 'build/**/*.test.js'",
    "dev:serve": "pnpm run copy:assets && node --enable-source-maps --import ./scripts/dev-env.mjs --import ./build/instrument.js build/index.js | pino-pretty -S -t -i hostname,pid",
    "dev": "tsc-watch --onSuccess \"pnpm run dev:serve\"",
    "import:wikimedia": "node --enable-source-maps --import ./scripts/dev-env.mjs build/wikimedia/importWikimedia.js",
    "deploy": "ssh ${DEPLOY_SSH_HOST:-freemap-fm6} 'cd /home/freemap/freemap-v3-nodejs-backend && git pull --ff-only && bash scripts/remote-deploy.sh'",
    "precommit": "lint-staged",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@koa/router": "^15.7.1",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@mapbox/tilebelt": "^2.0.3",
    "@polar-sh/sdk": "^1.1.0",
    "@sentry/node": "^11.12.0",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/center": "^7.4.0",
    "apple-signin-auth": "^2.1.0",
    "etag": "^1.8.1",
    "exifreader": "^4.54.0",
    "gdal-async": "^3.13.0",
    "got": "^16.2.0",
    "heic-convert": "^2.1.0",
    "jose": "^6.2.17",
    "kcors": "^2.2.2",
    "koa": "^3.3.0",
    "koa-body": "^8.0.1",
    "koa-websocket": "^7.0.0",
    "mariadb": "^3.5.5",
    "nanoid": "^6.0.2",
    "oauth-1.0a": "^2.2.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "protobufjs": "^8.8.1",
    "sharp": "0.35.5",
    "short-uuid": "^6.0.3",
    "sql-template-tag": "^5.2.1",
    "tsc-watch": "^7.2.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "zod-geojson": "^1.7.1",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/etag": "^1.8.4",
    "@types/geojson": "^7946.0.16",
    "@types/heic-convert": "^2.1.1",
    "@types/kcors": "^2.2.9",
    "@types/koa": "^3.0.3",
    "@types/koa-websocket": "^5.0.11",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "pino-pretty": "^13.2.0",
    "typescript": "~7.0.2"
  },
  "resolutions": {
    "@types/koa": "^3.0.0"
  }
}
